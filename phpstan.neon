includes:
    - tools/phpstan/vendor/larastan/larastan/extension.neon
    # Errors that predate Phase 0 (17 Oct 2026), so CI fails only on new ones. Work this list down; never add to it by hand.
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app/Services
        - app/Support
        - app/Exceptions
        - app/Http/Controllers/Api/V1
        - app/Http/Controllers/PaymentCallbackController.php
        - app/Http/Middleware
        - app/Http/Requests
        - app/Models/StockRecord.php
        - app/Models/SaleRecord.php
        - app/Models/SaleRecordItem.php
        - app/Models/Payment.php
        - app/Models/FinancialRecord.php
        - app/Models/FinancialCategory.php
        - app/Models/FinancialPeriod.php
        - app/Models/StockItem.php
        - app/Models/Company.php
        - app/Models/SaccoLedgerAccount.php
        - app/Models/SaccoLedgerHead.php
        - app/Models/SaccoJournalEntry.php
        - app/Models/SaccoJournalLine.php
        - app/Models/SaccoAccountBalance.php
        - app/Models/SaccoPeriod.php
        - app/Models/SaccoPeriodBalance.php
        - app/Models/SaccoSetting.php
        - app/Models/SaccoSavingsProduct.php
        - app/Models/SaccoSavingsProductVersion.php
        - app/Models/SaccoSavingsAccount.php
        - app/Models/SaccoTransaction.php
        - app/Models/SaccoShareAccount.php
        - app/Models/SaccoOfficer.php
        - app/Models/SaccoMember.php
        - app/Models/SaccoMemberRelation.php
        - app/Models/SaccoMemberDocument.php
        - app/Models/SaccoMemberLogin.php
        - app/Models/SaccoApproval.php
        - app/Models/SaccoApprovalVote.php
        - app/Models/SaccoPublicHoliday.php
        - app/Models/SaccoLoanProduct.php
        - app/Models/SaccoLoan.php
        - app/Models/SaccoLoanScheduleLine.php
        - app/Models/SaccoLoanGuarantor.php
        - app/Models/SaccoLoanCollateral.php
        - app/Models/SaccoLoanVote.php
        - app/Models/SaccoLoanDocument.php
        - app/Models/SaccoLoanRepayment.php
        - app/Models/SaccoLoanChange.php
        - app/Scopes
    excludePaths:
        - app/Services/AutoReorderService.php
        - app/Services/InventoryForecastService.php
    ignoreErrors:
        - '#Access to an undefined property App\\Models\\[A-Za-z]+::\$[A-Za-z_]+\.#'
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$[A-Za-z_]+\.#'
        - '#Access to an undefined property Illuminate\\Contracts\\Auth\\Authenticatable::\$[A-Za-z_]+\.#'
        - '#Laravel\\Sanctum\\Contracts\\HasAbilities#'
    reportUnmatchedIgnoredErrors: false
