# Budget Pro, the kernel (schema, services, /api/v1, scheduler, classic admin). Copy to .env and fill in;
# never commit real values.
#
# Every key the config files read is listed here (tests/Unit/EnvExampleTest fails when one is missing).
# A commented line (# KEY=value) is a key whose default is right for most copies; the value shown is that
# default. Values suit a local copy; the production value is in the comment above a key.
#
# `php artisan config:doctor` checks these settings. In production it fails (and stops a deploy) when
# mail, SMS, WhatsApp, payments or the queue would quietly be off, debug is on, SAAS_DATA_KEY or the
# support WhatsApp is empty, or a plaintext MASTER_PASSWORD is set.
#
# budget-pro-new loads several of these config files (saas, messaging, flutterwave, edition, demo, mobile,
# admin, onboarding, permissions, support) into its own process, so those keys must carry the same
# values in its .env too (see its .env.example).

# ── App and edition ──────────────────────────────────────────────────────────
APP_NAME="Budget Pro"
# production
APP_ENV=local
# php artisan key:generate
APP_KEY=
# production: false (config:doctor fails while it is on)
APP_DEBUG=true
# production: the https address
APP_URL=http://localhost
# saas | standalone. The standalone installer writes it; never changed afterwards.
APP_EDITION=saas
# Standalone only (the installer writes these): the licence file, the web app's folder, where updates come
# from (empty = upload only) and the buyer's web folder that public/ is served from. Default licence file:
# storage/app/private/licence.json in this folder.
# APP_LICENCE_PATH=
# BUDGETPRO_WEB_PATH=
# APP_UPDATE_SERVER=https://budget-dynamics.schooldynamics.ug
# APP_PUBLIC_PATH=

# ── Classic admin ────────────────────────────────────────────────────────────
# Empty on the SaaS; "classic" on a standalone copy (both apps share one address there).
# ADMIN_ROUTE_PREFIX=
# ADMIN_HTTPS=false
# ADMIN_SKIN=skin-red
# The first platform administrator, made by `php artisan db:seed` (PlatformAdminSeeder). Empty = skipped.
# The password needs 10 characters or more. Remove both once the account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Logging and errors ───────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# production: warning
LOG_LEVEL=debug
# Optional: Sentry (or GlitchTip) DSN, on top of the built-in error tracker.
# SENTRY_LARAVEL_DSN=

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=budget_pro
DB_USERNAME=root
DB_PASSWORD=
# MAMP: /Applications/MAMP/tmp/mysql/mysql.sock
# DB_SOCKET=

# ── Queue, cache, session, files ─────────────────────────────────────────────
# The database queue (ADR 0008): the scheduler drains it every minute, also for the jobs budget-pro-new
# queues. config:doctor fails on sync in production. Tests use sync (phpunit.xml).
QUEUE_CONNECTION=database
CACHE_DRIVER=file
# Attempt limits count in the database (atomic; the `cache` table). Tests use array (phpunit.xml).
# CACHE_LIMITER_STORE=limiter
FILESYSTEM_DISK=local
BROADCAST_DRIVER=log
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Standalone: bp_classic_session (the web app's cookie is bp_shop_session).
# SESSION_COOKIE=budget_pro_session
# SESSION_DOMAIN=
# production (https): true
# SESSION_SECURE_COOKIE=

# ── API tokens (Sanctum) ─────────────────────────────────────────────────────
# One token per device; 180 days.
# SANCTUM_EXPIRATION_MINUTES=259200
# Default: localhost and 127.0.0.1 (common ports) plus APP_URL's host.
# SANCTUM_STATEFUL_DOMAINS=
# SANCTUM_TOKEN_PREFIX=

# ── Mail ─────────────────────────────────────────────────────────────────────
# production: smtp, with the host's mail server below (config:doctor fails on log or array)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls, or ssl for port 465 (budget-pro-new reads MAIL_SCHEME instead)
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Notification emails (Utils::mail_sender). Off = dropped with a log line; config:doctor fails on that in production.
SAAS_MAIL_ENABLED=true

# ── Messaging: email, SMS, WhatsApp (config/messaging.php) ──────────────────
# `log` writes to message_log only and marks the message sent: right for development and tests, never for
# production (config:doctor fails on it). Production values: mail, africastalking, meta.
MESSAGING_MAIL_DRIVER=log
# Sign-in and reset codes go by email, free. true also sends them to phones by WhatsApp, then SMS (paid per message).
OTP_PHONE_CODES=false
SMS_DRIVER=log
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# AFRICASTALKING_ENDPOINT=https://api.africastalking.com/version1/messaging
WHATSAPP_DRIVER=log
# Meta WhatsApp Cloud API: a permanent token and the sending number's id.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved templates: the OTP, and the receipt (params: shop, receipt no., total, link).
# WHATSAPP_OTP_TEMPLATE=otp_code
# WHATSAPP_RECEIPT_TEMPLATE=sale_receipt
# WHATSAPP_API_VERSION=v21.0

# ── Payments: Flutterwave ────────────────────────────────────────────────────
# Live keys in production: config:doctor fails on test keys (FLWSECK_TEST..., FLWPUBK_TEST...), on an empty
# secret key, and on an empty FLW_SECRET_HASH (every webhook is then refused).
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_ENCRYPTION_KEY=
FLW_SECRET_HASH=
FLW_BASE_URL=https://api.flutterwave.com
FLW_CURRENCY=UGX
FLW_PAYMENT_OPTIONS=mobilemoneyuganda,card,banktransfer,ussd
FLW_TIMEOUT=20
# Where the browser returns after a hosted checkout. Default: APP_URL plus /payment/callback.
# FLW_REDIRECT_URL="${APP_URL}/payment/callback"
# International customers: card only, billed in USD.
# FLW_INTL_PAYMENT_OPTIONS=card
# FLW_INTL_CURRENCY=USD
# Mobile money per local billing currency.
# FLW_KES_PAYMENT_OPTIONS=mpesa,card
# FLW_TZS_PAYMENT_OPTIONS=mobilemoneytanzania,card
# FLW_RWF_PAYMENT_OPTIONS=mobilemoneyrwanda,card
# Mobile-money networks for shop collections (Flutterwave account_bank codes).
# FLW_UG_MTN_CODE=MTN
# FLW_UG_AIRTEL_CODE=AIRTEL
# FLW_KE_MPESA_CODE=MPS
# FLW_TZ_VODA_CODE=VODAFONE
# FLW_TZ_TIGO_CODE=TIGO
# FLW_TZ_AIRTEL_CODE=AIRTEL
# FLW_TZ_HALO_CODE=HALOPESA
# FLW_RW_MTN_CODE=MTN
# FLW_RW_AIRTEL_CODE=AIRTEL
# The platform's share of shop collections, in percent (always 0 on standalone).
# FLW_MOMO_PLATFORM_FEE_PERCENT=0

# ── SaaS ─────────────────────────────────────────────────────────────────────
# The key both apps encrypt shared values with (EFRIS keys, Connections, web links): the SAME value in
# budget-pro-new's .env. Empty = each app's own APP_KEY, and each silently loses what the other encrypted
# (config:doctor fails on that in production). Make one with: php artisan key:generate --show
SAAS_DATA_KEY=
# Where budget-pro itself is served (receipts /r/..., classic invites). Default: APP_URL.
# SAAS_PUBLIC_URL=
# The web portal (budget-pro-new): the classic top bar's link, web sign-in links, buyer links.
# production: the portal's https address
SAAS_NEW_UI_URL=
# Send shop users from classic screens to the same screen in the web portal.
SAAS_REDIRECT_TO_NEW_UI=false
# Where team invite links open. Empty = the classic invite page. production: the portal's https address
SAAS_INVITE_URL=
# Where Upgrade and Renew send people (e.g. https://portal.example.com/plan). Empty = the classic billing page.
SAAS_BILLING_URL=
# SAAS_TRIAL_DAYS=14
# SAAS_DEFAULT_PLAN=trial
# SAAS_GRACE_DAYS=7
# SAAS_FREE_TIER_FALLBACK=true
# SAAS_FREE_PLAN=free
# SAAS_DISPLAY_TIMEZONE=Africa/Kampala
# SAAS_DEFAULT_CURRENCY=UGX
# SAAS_LOW_STOCK_THRESHOLD=10
# SAAS_UPLOAD_MAX_KB=5120
# Card auto-renew with Flutterwave's saved-card token; off until tested live.
# SAAS_AUTO_RENEW=false
# SAAS_AUTO_RENEW_HOURS_BEFORE=48
# How long pending invoices are re-checked with Flutterwave, hourly.
# SAAS_RECONCILE_HOURS=72
# Seller details and tax on subscription invoices. Empty lines are not printed. Default name: APP_NAME.
# SAAS_INVOICE_SELLER_NAME="Budget Pro"
SAAS_INVOICE_SELLER_ADDRESS=
SAAS_INVOICE_SELLER_TIN=
SAAS_INVOICE_SELLER_EMAIL=
SAAS_INVOICE_SELLER_PHONE=
# SAAS_INVOICE_TAX_LABEL=VAT
# SAAS_INVOICE_TAX_RATE=0

# ── Support (config/support.php, one number for every surface) ───────────────
# Digits with the country code, for wa.me links. config:doctor fails in production while it is empty.
SUPPORT_WHATSAPP=256783204665
SUPPORT_PHONE="+256 783 204 665"
# The platform's support inbox. A personal address never goes here.
SUPPORT_EMAIL=
SUPPORT_HOURS="Monday to Saturday, 8:00 to 20:00"
# A public status page, when there is one.
SUPPORT_STATUS_URL=

# ── Master password (SaaS only, never on standalone) ─────────────────────────
# Only its bcrypt hash: php artisan master-password:set (20 characters or more), the same line in both apps.
# Empty = off. The plaintext MASTER_PASSWORD is removed: it is ignored, and config:doctor fails while it is set.
MASTER_PASSWORD_HASH=
# Where it works: comma-separated IPs or CIDR ranges. Empty = nowhere.
MASTER_PASSWORD_ALLOWED_IPS=
# A session it opens ends after this many minutes.
# MASTER_PASSWORD_SESSION_MINUTES=60
# "Sign in as" on the classic Companies screen (platform admin, with a reason) is the supported path.
# true = the plain classic and web sign-in forms take it too, with no record of who or why. Default false.
MASTER_PASSWORD_ON_SIGN_IN_FORMS=false

# ── Owner alerts (each master password use) ──────────────────────────────────
# Empty = the support contact above.
OWNER_ALERT_EMAIL=
OWNER_ALERT_WHATSAPP=

# ── Passwords ────────────────────────────────────────────────────────────────
# New passwords are checked against the public list of leaked passwords (k-anonymity; fails open).
# PASSWORD_BREACH_CHECK=true

# ── Config doctor ────────────────────────────────────────────────────────────
# Failures the owner has decided to live with for now: comma-separated check keys (e.g. whatsapp,sms).
# Each still shows as a warning marked "accepted by the owner" in config:doctor and System health.
# Never accepted: app_debug, data_key, queue_sync, flutterwave_test_mode, master_password_plaintext, edition.
# Every key: php artisan config:doctor (last lines), or App\Support\ConfigDoctor.
CONFIG_DOCTOR_ACCEPT=

# ── Mobile apps and the legacy API ───────────────────────────────────────────
# Apps older than the minimum get 426 "update required".
# MOBILE_MIN_VERSION=2.0.0
# MOBILE_LATEST_VERSION=2.0.0
# MOBILE_STORE_URL=https://play.google.com/store/apps/details?id=com.budget.dynamics
# Where the payment result page returns to the app.
# MOBILE_DEEP_LINK=budgetpro://billing
# The pre-v1 routes of the old app. Off once `php artisan legacy:status` says so.
# LEGACY_API_ENABLED=true

# ── Fiscal receipts: EFRIS (URA). Credentials are per shop, in Settings. ────
# EFRIS_SANDBOX_URL=https://efristest.ura.go.ug/efrisws/ws/taapp/getInformation
# EFRIS_PRODUCTION_URL=https://efrisws.ura.go.ug/ws/taapp/getInformation
# EFRIS_APP_ID=AP04
# EFRIS_VERSION=1.1.20191201
# EFRIS_TIMEOUT=30

# ── Backups and data requests ────────────────────────────────────────────────
# Default path: storage/app/backups
# BACKUP_PATH=
# BACKUP_KEEP_DAYS=14
# BACKUP_MYSQLDUMP=mysqldump
# BACKUP_MYSQL=mysql
# An empty scratch database the weekly restore drill may overwrite. Unset = the drill reads the dump only.
# BACKUP_DRILL_DATABASE=
# Days between a shop's deletion request and the purge.
# TENANT_DELETION_GRACE_DAYS=30

# ── The public demo shop (SaaS) ──────────────────────────────────────────────
# DEMO_PUBLIC=true
# DEMO_EMAIL=demo@schooldynamics.ug
# DEMO_PASSWORD=demo2026
# DEMO_REBUILD_HOURS=72
# DEMO_DAYS=60
# DEMO_TOKEN_HOURS=12
# The Akiba Ledger demo SACCO (config/demo.php `sacco`, `sacco:demo`): its own switch, password and schedule.
# DEMO_SACCO=true
# DEMO_SACCO_PASSWORD=demo-sacco-2026
# DEMO_SACCO_REBUILD_HOURS=72
# DEMO_SACCO_MONTHS=18
# DEMO_SACCO_COUNTER=14

# ── Akiba Ledger, the SACCO module (config/sacco.php) ────────────────────────
# The Akiba plan line's trial and free fallback (AkibaPlanSeeder).
# SACCO_TRIAL_PLAN=akiba-trial
# SACCO_FREE_PLAN=akiba-free
# Who regulates SACCOs (printed only for licensed SACCOs that ask for it).
# SACCO_REGULATOR_NAME="Uganda Microfinance Regulatory Authority"
# SACCO_REGULATOR_SHORT=UMRA
SACCO_REGULATOR_PORTAL=
# Mobile-money payouts: off (until the owner adds keys), simulated (local only) or flutterwave.
SACCO_PAYOUTS_DRIVER=off
# Members' mobile-money collections (request-to-pay): off | simulated (local only; config:doctor fails production) | flutterwave.
SACCO_COLLECTIONS_DRIVER=off
# Local only: how long the simulated payouts and collections take, in seconds.
# SACCO_PAYOUTS_SIMULATED_DELAY=0
# SACCO_COLLECTIONS_SIMULATED_AFTER=6
# Links to members and guarantors open here (the Akiba Ledger site): https://akiba-ledger.example
SACCO_PUBLIC_URL=
# Without SACCO_PUBLIC_URL: the Akiba Ledger site's domain (the portal's app-site key), https:// is added.
APP_AKIBA_LEDGER_DOMAIN=
# The secret the members' NIN lookup hash is keyed with. Required in production; never change it once set.
SACCO_NIN_PEPPER=

# ── Releases and licences (SaaS only; never in a release) ────────────────────
# The Ed25519 key that signs releases and licences: php artisan licensing:keygen
# RELEASE_SIGNING_KEY_ID=
# RELEASE_SIGNING_SECRET=
# The two repositories a release is built from (defaults: this folder and ../budget-pro-new), and Composer.
# RELEASE_KERNEL_PATH=
# RELEASE_WEB_PATH=
# RELEASE_COMPOSER=
# An EMPTY database for a release's clean-install proof. Never the application's own database.
# RELEASE_TEST_DB_HOST=
# RELEASE_TEST_DB_PORT=3306
# RELEASE_TEST_DB_DATABASE=
# RELEASE_TEST_DB_USER=
# RELEASE_TEST_DB_PASSWORD=
# RELEASE_TEST_DB_SOCKET=

# ── Framework drivers this host does not use (ADR 0008: no Redis, S3 or Pusher) ─
MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
