<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <!-- Slow: a real install of a whole release in a subprocess (about 75 s), left out of the usual run.
         Run it on demand with the options "group slow" and "exclude-group none" (see ReleaseProofTest). -->
    <groups>
        <exclude>
            <group>slow</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_EDITION" value="saas"/>
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!--
            Tests run against a dedicated MySQL database (budget_pro_test) whose
            schema mirrors production. Tests use DatabaseTransactions (roll back
            after each test) rather than RefreshDatabase, so no data is persisted
            and the app database is never touched.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="budget_pro_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="FLW_SECRET_KEY" value="FLWSECK_TEST-x"/>
        <env name="FLW_PUBLIC_KEY" value="FLWPUBK_TEST-x"/>
        <env name="FLW_SECRET_HASH" value="test-webhook-hash"/>
        <env name="FLW_BASE_URL" value="https://api.flutterwave.com"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
